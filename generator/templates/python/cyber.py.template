import socket
import subprocess
from typing import Optional

class {{ComponentName}}:
    def __init__(self, target: str):
        self.target  = target
        self.results = []

    def resolve(self) -> Optional[str]:
        """Resolve hostname to IP."""
        try:
            ip = socket.gethostbyname(self.target)
            print(f"  [+] Resolved: {self.target} → {ip}")
            return ip
        except socket.gaierror:
            print(f"  [-] Could not resolve: {self.target}")
            return None

    def port_scan(self, ports: list = [80, 443, 22, 21, 8080]) -> list:
        """Basic TCP port scanner."""
        open_ports = []
        for port in ports:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1)
                result = sock.connect_ex((self.target, port))
                if result == 0:
                    print(f"  [+] Port {port} is OPEN")
                    open_ports.append(port)
                sock.close()
            except Exception as e:
                print(f"  [-] Error on port {port}: {e}")
        return open_ports

    def run(self) -> dict:
        """Run all recon tasks."""
        ip    = self.resolve()
        ports = self.port_scan()

        self.results = {"target": self.target, "ip": ip, "open_ports": ports}
        return self.results


if __name__ == "__main__":
    tool = {{ComponentName}}("example.com")
    tool.run()